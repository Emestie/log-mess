{
    "name": "log-mess",
    "version": "0.0.2",
    "description": "Log messages with tags and configuration",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "types": "./dist/index.d.cts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "zshy": {
        "exports": {
            ".": "./src/index.ts"
        }
    },
    "license": "ISC",
    "author": {
        "name": "Emestie",
        "email": "emestie@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Emestie/log-mess"
    },
    "keywords": [
        "log",
        "message",
        "console"
    ],
    "files": [
        "dist/**",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "zshy",
        "test": "vitest run",
        "prepublishOnly": "node ./changelog.mjs"
    },
    "devDependencies": {
        "jsdom": "^26.1.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4",
        "zshy": "^0.3.5"
    },
    "dependencies": {
        "persival": "^0.0.7"
    }
}
